# OpenRouter standalone inference example.
# Use either OPENROUTER_MODEL or OPENROUTER_PRESET, never both.
# Presets must use @preset/<slug>. BYOK is configured in the OpenRouter workspace,
# not in this runtime. Strict routing does not guarantee BYOK by itself; configure
# the workspace to always use the selected provider key and fix the provider below.
# This runtime does not enable input/output logging or external observability.
# OpenRouter requests are non-streaming in this runtime path.

INFERENCE_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_PRESET=
OPENROUTER_BASE_URL=
OPENROUTER_ALLOW_CUSTOM_BASE_URL=false

# strict: requires OPENROUTER_ALLOWED_PROVIDERS and forces conservative routing.
# balanced: keeps conservative defaults but allows explicit routing settings.
OPENROUTER_ROUTING_MODE=strict
OPENROUTER_ALLOWED_PROVIDERS=provider-slug
OPENROUTER_PROVIDER_ORDER=provider-slug
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=false

OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
OPENROUTER_TRACE_ENABLED=false
OPENROUTER_TRACE_PROJECT=
OPENROUTER_TRACE_ENVIRONMENT=development
